  "mapping": {
    "orders_30d": {
      "feature": "customer.orders_30d",
      "version": "1.0.0",
      "legacy_sql": "COUNT(*) AS orders_30d"
    },
    "distinct_orders_30d": {
      "feature": "customer.distinct_orders_30d",
      "version": "1.0.0",
      "legacy_sql": "COUNT(DISTINCT o.order_id) AS distinct_orders_30d"
    },
    "settled_spend_30d": {
      "feature": "customer.settled_spend_30d",
      "version": "1.0.0",
      "legacy_sql": "COALESCE(SUM(CASE WHEN o.status = 'settled' THEN o.amount_cents END), 0) AS settled_spend_30d"
    },
    "avg_order_value_30d": {
      "feature": "customer.avg_order_value_30d",
      "version": "1.0.0",
      "legacy_sql": "AVG(o.amount_cents) AS avg_order_value_30d"
    },
    "max_order_value_30d": {
      "feature": "customer.max_order_value_30d",
      "version": "1.0.0",
      "legacy_sql": "MAX(o.amount_cents) AS max_order_value_30d"
    },
    "web_orders_30d": {
      "feature": "customer.web_orders_30d",
      "version": "1.0.0",
      "legacy_sql": "COUNT(*) FILTER(WHERE o.channel = 'web') AS web_orders_30d"
    },
    "store_orders_30d": {
      "feature": "customer.store_orders_30d",
      "version": "1.0.0",
      "legacy_sql": "COUNT(*) FILTER(WHERE o.channel = 'store') AS store_orders_30d"
    },
    "returns_30d": {
      "feature": "customer.returns_30d",
      "version": "1.0.0",
      "legacy_sql": "COUNT(CASE WHEN o.status = 'returned' THEN 1 END) AS returns_30d"
    },
    "discount_30d": {
      "feature": "customer.discount_30d",
      "version": "1.0.0",
      "legacy_sql": "COALESCE(SUM(o.discount_cents), 0) AS discount_30d"
    },
    "card_payments_30d": {
      "feature": "customer.card_payments_30d",
      "version": "1.0.0",
      "legacy_sql": "COUNT(CASE WHEN o.payment_method = 'card' THEN 1 END) AS card_payments_30d"
    },
    "wallet_payments_30d": {
      "feature": "customer.wallet_payments_30d",
      "version": "1.0.0",
      "legacy_sql": "COUNT(CASE WHEN o.payment_method = 'wallet' THEN 1 END) AS wallet_payments_30d"
    },
    "max_shipping_days_30d": {
      "feature": "customer.max_shipping_days_30d",
      "version": "1.0.0",
      "legacy_sql": "MAX(o.shipping_days) AS max_shipping_days_30d"
    },
    "avg_shipping_days_30d": {
      "feature": "customer.avg_shipping_days_30d",
      "version": "1.0.0",
      "legacy_sql": "AVG(o.shipping_days) AS avg_shipping_days_30d"
    },
    "return_rate_30d": {
      "feature": "customer.return_rate_30d",
      "version": "1.0.0",
      "legacy_sql": "returns_30d / NULLIF(orders_30d, 0) AS return_rate_30d"
    },
    "web_share_30d": {
      "feature": "customer.web_share_30d",
      "version": "1.0.0",
