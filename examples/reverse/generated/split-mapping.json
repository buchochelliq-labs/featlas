  "compatibility_view_sql": "-- Compatibility view: the wide customer_wide shape over the split tables.\nCREATE OR REPLACE VIEW `main`.`features`.`customer_wide_featlas_compat` AS\nSELECT t0.`tenant_id`, t0.`customer_id`, t0.`feature_as_of`, t0.`web_orders_30d`, t0.`store_orders_30d`, t0.`web_share_30d`, t1.`max_shipping_days_30d`, t1.`avg_shipping_days_30d`, t2.`card_payments_30d`, t2.`wallet_payments_30d`, t3.`orders_30d`, t3.`distinct_orders_30d`, t4.`returns_30d`, t4.`return_rate_30d`, t5.`settled_spend_30d`, t5.`avg_order_value_30d`, t5.`max_order_value_30d`, t5.`discount_30d`\nFROM `main`.`features`.`customer_wide_featlas_channel` t0\nFULL OUTER JOIN `main`.`features`.`customer_wide_featlas_fulfilment` t1 ON t1.`tenant_id` = t0.`tenant_id` AND t1.`customer_id` = t0.`customer_id` AND t1.`feature_as_of` = t0.`feature_as_of`\nFULL OUTER JOIN `main`.`features`.`customer_wide_featlas_payments` t2 ON t2.`tenant_id` = t0.`tenant_id` AND t2.`customer_id` = t0.`customer_id` AND t2.`feature_as_of` = t0.`feature_as_of`\nFULL OUTER JOIN `main`.`features`.`customer_wide_featlas_purchasing` t3 ON t3.`tenant_id` = t0.`tenant_id` AND t3.`customer_id` = t0.`customer_id` AND t3.`feature_as_of` = t0.`feature_as_of`\nFULL OUTER JOIN `main`.`features`.`customer_wide_featlas_returns` t4 ON t4.`tenant_id` = t0.`tenant_id` AND t4.`customer_id` = t0.`customer_id` AND t4.`feature_as_of` = t0.`feature_as_of`\nFULL OUTER JOIN `main`.`features`.`customer_wide_featlas_revenue` t5 ON t5.`tenant_id` = t0.`tenant_id` AND t5.`customer_id` = t0.`customer_id` AND t5.`feature_as_of` = t0.`feature_as_of`"
